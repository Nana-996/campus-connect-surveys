# Supabase (public client — safe to expose)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-side (used by server functions / SSR)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_PROJECT_ID="your-project-ref"

# Server-only — keep secret, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Canonical site URL used in SEO metadata, sitemap, OG tags, share links.
# Set this to your deployed origin (no trailing slash).
VITE_SITE_URL="https://your-domain.com"
